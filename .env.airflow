# .env.airflow — Environment variables for docker-compose-airflow.yml
#
# Copy this to .env before running docker compose:
#   cp .env.airflow .env
#
# Then edit the values below.

# Your Linux user ID (required for file permissions in mounted volumes)
# Run: echo $(id -u) to get your UID
AIRFLOW_UID=1000

# GCP Project ID
GCP_PROJECT=nifty-quanta-486115-d6

# Exchange Rates API key (from openexchangerates.org)
EXCHANGE_RATES_API_KEY=your_api_key_here

# Airflow admin credentials (change in production)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
