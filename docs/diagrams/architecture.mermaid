        I["🔍 Quality Gates<br/>Circuit Breakers"]
        J["🥇 BigQuery Marts<br/>Star Schema (dbt)"]
    end

    subgraph Consumption["Consumption Layer"]
        K["📊 Streamlit Dashboard"]
        L["🔎 BigQuery SQL Workspace"]
    end

    subgraph Orchestration["Cloud Composer / Airflow"]
        M["DAG: retail_analytics_daily"]
    end

    A --> D
